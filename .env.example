# Copy to .env and fill in the blanks. Never commit .env.
# Use URL-safe characters in POSTGRES_PASSWORD (it is placed inside a connection URL).

APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=sentinelx
POSTGRES_DB=sentinelx

# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# The application's own database role: it can read and write rows but not change the schema
# or disable the audit-log triggers (migrations use the POSTGRES_USER above).
# Generate with:  openssl rand -hex 24
APP_DB_USER=sentinelx_app
APP_DB_PASSWORD=

# Signs access tokens. At least 32 random characters (checked at startup).
# Generate with:  openssl rand -hex 32
SECRET_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8081,http://localhost:5174

# Only when running the backend directly on your machine (outside Docker). Use 127.0.0.1, not
# localhost (localhost may try IPv6 first and slow every connection):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5433/DBNAME
# LOG_FORMAT=text
